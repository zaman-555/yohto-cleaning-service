generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  password            String
  isApproved          Boolean  @default(false)
  isAdmin             Boolean  @default(false)
  dashboardStaffOrder Int[]    @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tasks               Task[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model Task {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  shift         String
  userId        Int
  companyName   String
  task          String
  carName       String
  transportType String
  location      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("task")
}

/// Controls when a future monthly schedule becomes visible to staff.
model ScheduleMonthVisibility {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, month], map: "schedule_month_visibility_year_month_key")
  @@map("schedule_month_visibility")
}

/// Weekly showcase cells. `rowKey` encodes placement, e.g. `2026-w18-1` (year, calendar week, row).
model TaskDetail {
  id        Int      @id @default(autoincrement())
  rowKey    String
  columnKey String
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([rowKey, columnKey], map: "task_details_rowKey_columnKey_key")
  @@map("task_details")
}

/// Admin-editable labels and header styles for weekly showcase columns.
model WeeklyShowcaseColumnHeader {
  columnKey   String   @id
  label       String
  headerStyle String   @default("default")
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("weekly_showcase_column_headers")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
